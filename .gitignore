# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*~

# Temp
*.tmp
~$*

# Python (прототип)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Go
bin/
dist/
*.test
*.out
vendor/
# Пробные сборки: go build без -o кладёт exe с именем каталога рядом
Source/app/app.exe
Source/app/app
Source/core/core.exe

# Собранные приложения — в репозиторий не кладём, кроме выпусков в Release
*.apk
*.apk.idsig
*.aab
.apk-work/
*.keystore
# Выпуски в Release кладутся в историю по прямому решению владельца:
# готовый пакет должен лежать в репозитории, а не собираться заново.
!Release/*.apk

# Прошлые версии — правило 13: с диска не удаляются, но в репозиторий не
# заливаются. В истории они уже есть; заново их туда класть не нужно, а
# на диске они нужны для откатов и раздачи.
Release/Архив/

# iOS и macOS пакеты собираются только в GitHub CI и выкладываются прямо
# в раздел выпусков, а не в git. Держать их в репозитории незачем — и
# опасно: старый закоммиченный .ipa однажды перебил свежую CI-сборку
# (ls ... | head -1 брал его по алфавиту).
Release/*.ipa
Release/*.dmg

# tor от Guardian Project — качается скриптом сборки, в репозиторий не кладём
Source/app/tor-android/

# tor.exe для Windows — вход сборки (из Tor Browser, TOR_BINARY или
# tor-windows/). Кладётся рядом с приложением при упаковке, в репозиторий
# не идёт.
Source/app/tor-windows/

# tor для iOS — тоже качается при сборке (рамка iCepa, около 140 МБ).
# В репозитории лежит только скрипт, который её приносит.
Source/app/.tor-ios-cache/
Source/core/torrun/torlib/lib/
Source/core/torrun/torlib/include/

# Готовые сборки под Apple
Source/app/*.app/
Source/app/launch.log

# Мобильные сборки
/android/build/
/android/.gradle/
/android/local.properties
/ios/build/
/ios/Pods/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Артефакты gomobile
*.aar
*.xcframework/
*.framework/

# Секреты и подпись — в git не попадают никогда
Token.txt
*.p12
*.keystore
*.jks
*.mobileprovision
*.cer
signing.env

# Состояние Tor во время отладки
torrc
tor.log
control_port
control_auth_cookie
