# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*~

# Temp
*.tmp
~$*

# Python (прототип)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Go
bin/
dist/
*.test
*.out
vendor/

# Собранные приложения — в репозиторий не кладём, кроме выпусков в Release
*.apk
*.apk.idsig
*.aab
.apk-work/
*.keystore
# Выпуски в Release кладутся в историю по прямому решению владельца:
# готовый пакет должен лежать в репозитории, а не собираться заново.
!Release/*.apk

# Прошлые версии — правило 13: с диска не удаляются, но в репозиторий не
# заливаются. В истории они уже есть; заново их туда класть не нужно, а
# на диске они нужны для откатов и раздачи.
Release/Архив/

# tor от Guardian Project — качается скриптом сборки, в репозиторий не кладём
Source/app/tor-android/

# tor для iOS — тоже качается при сборке (рамка iCepa, около 140 МБ).
# В репозитории лежит только скрипт, который её приносит.
Source/app/.tor-ios-cache/
Source/core/torrun/torlib/lib/
Source/core/torrun/torlib/include/

# Готовые сборки под Apple
Source/app/*.app/
Source/app/launch.log

# Мобильные сборки
/android/build/
/android/.gradle/
/android/local.properties
/ios/build/
/ios/Pods/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Артефакты gomobile
*.aar
*.xcframework/
*.framework/

# Секреты и подпись — в git не попадают никогда
Token.txt
*.p12
*.keystore
*.jks
*.mobileprovision
*.cer
signing.env

# Состояние Tor во время отладки
torrc
tor.log
control_port
control_auth_cookie
